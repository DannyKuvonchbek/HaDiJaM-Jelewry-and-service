
# Provider-backed admin product review only; public catalog concierge does not require an AI key.
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# AI_API_KEY=

# MongoDB Atlas or a replica-set URI is required for transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/hadijam?replicaSet=rs0


# Seller approval uses MongoDB transactions: Atlas or a replica-set URI is required.
# Keep private documents on a persistent volume OUTSIDE uploads/.
# PRIVATE_DOCUMENT_DIR=/absolute/private/persistent-volume/seller-documents

# SMS is disabled until a gateway implementing docs/ADMIN_SELLER_SETUP.md is configured.

# Session configuration. Replace the placeholder with a random secret before use.
NODE_ENV=development
PORT=9702
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# JWT lifetime is fixed in code to 240 seconds; legacy JWT_EXPIRES_IN is ignored.
# Production origins: https://hadijam.com and https://www.hadijam.com
# Development frontend origin: http://localhost:1017
